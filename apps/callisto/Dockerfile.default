# Standalone callisto image. Build from the repository root so the local
# packages/juno module (referenced via a replace directive) is available:
# > docker build -f apps/callisto/Dockerfile.default -t callisto .
FROM golang:1.26.11-alpine AS builder
RUN apk update && apk add --no-cache make git build-base gcc
WORKDIR /go/src/github.com/xrplevm/cosmos-explorer
COPY go.work go.work.sum ./
COPY packages/juno ./packages/juno
COPY apps/callisto ./apps/callisto
WORKDIR /go/src/github.com/xrplevm/cosmos-explorer/apps/callisto
RUN go mod download
RUN make build

FROM alpine:latest
WORKDIR /callisto
COPY --from=builder /go/src/github.com/xrplevm/cosmos-explorer/apps/callisto/build/callisto /usr/bin/callisto
EXPOSE 3000
CMD [ "callisto" ]
